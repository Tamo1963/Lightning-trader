{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JevDecisionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "strategy_id", "strategy_version", "instrument", "horizon_minutes", "candidate", "setup_type", "features", "data_quality", "event_risk", "policy_id", "question", "allowed_decisions"],
  "properties": {
    "request_id": {"type": "string"},
    "strategy_id": {"type": "string"},
    "strategy_version": {"type": "string"},
    "instrument": {"enum": ["NIFTY", "BANKNIFTY"]},
    "horizon_minutes": {"type": "integer", "minimum": 5},
    "candidate": {"enum": ["BUY_CALL", "BUY_PUT"]},
    "setup_type": {"enum": ["TREND_CONTINUATION", "BREAKOUT", "PULLBACK"]},
    "market_regime": {"enum": ["BULLISH_TREND", "BEARISH_TREND", "SIDEWAYS", "VOLATILE"]},
    "features": {
      "type": "object",
      "description": "Normalized, labeled numeric/boolean features. No dates, tickers or account data in replay mode.",
      "additionalProperties": {"type": ["number", "boolean", "string"]}
    },
    "statistical_forecast": {
      "type": "object",
      "description": "Present only in variant A+S+J.",
      "required": ["p_up", "p_down", "p_flat", "model_version"],
      "properties": {
        "p_up": {"type": "number", "minimum": 0, "maximum": 1},
        "p_down": {"type": "number", "minimum": 0, "maximum": 1},
        "p_flat": {"type": "number", "minimum": 0, "maximum": 1},
        "model_version": {"type": "string"}
      }
    },
    "data_quality": {"enum": ["PASS"]},
    "event_risk": {"enum": ["NORMAL", "ELEVATED"]},
    "policy_id": {"type": "string"},
    "question": {"type": "string"},
    "allowed_decisions": {"const": ["APPROVE", "REJECT", "INSUFFICIENT_EVIDENCE"]}
  }
}
