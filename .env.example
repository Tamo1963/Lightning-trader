# Copy to .env (git-ignored). Never commit real keys. Never paste keys into chats or logs.
JEV_API_KEY=              # TypeSafe key; TYPESAFE_API_KEY (the SDK's own name) also works
JEV_MODEL=jev-1.13.0     # pinned, never use a floating alias
DHAN_ACCESS_TOKEN=        # daily token
DHAN_CLIENT_ID=           # required by the option-chain endpoint (shadow mode)
